{
  "name": "marketplace",
  "version": "1.0.0",
  "description": "> Decentralized marketplace for African art, built on Stellar + Soroban smart contracts.",
  "main": "index.js",
  "workspaces": [
    "frontend/afristore-app",
    "indexer"
  ],
  "scripts": {
    "postinstall": "npm --workspace=indexer run prisma:generate",
    "dev": "concurrently \"npm --workspace=indexer run dev\" \"npm --workspace=frontend/afristore-app run dev\" \"npm --workspace=indexer run crank\"",
    "build:contracts": "cargo build --target wasm32v1-none --release --workspace",
    "test:contracts": "cargo test --workspace",
    "deploy:local": "bash scripts/deploy/deploy_contract.sh"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^10.0.4"
  },
  "overrides": {
    "next": {
      "postcss": ">=8.5.26"
    },
    "form-data": "^4.0.1",
    "fast-uri": ">=4.1.2",
    "ip-address": ">=10.5.0",
    "sharp": ">=0.35.3"
  }
}
