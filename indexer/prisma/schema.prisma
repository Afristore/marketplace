// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SyncState {
  id               Int      @id @default(1)
  lastLedger       Int      @default(0)
  lastLedgerHash   String?
  updatedAt        DateTime @updatedAt
}

model Listing {
  listingId       BigInt   @id
  artist          String
  owner           String?
  price           Decimal  @db.Decimal(32, 7)
  currency        String
  collection      String
  nftTokenId      BigInt
  amount          Int      @default(1)
  token           String
  metadataCid     String?
  category        String?  // Art category denormalized from IPFS metadata for server-side filtering
  status          String   // "Active", "Sold", "Cancelled", "Auction"
  recipients      Json?
  createdAtLedger Int
  updatedAtLedger Int
  @@index([artist])
  @@index([status])
  @@index([category])
  @@index([updatedAtLedger])
}

model Auction {
  auctionId       BigInt   @id
  creator         String
  collection      String
  nftTokenId      BigInt
  amount          Int      @default(1)
  token           String
  metadataCid     String?
  reservePrice    Decimal  @db.Decimal(32, 7)
  highestBid      Decimal  @db.Decimal(32, 7)
  highestBidder   String?
  endTime         BigInt
  status          String   // "Active", "Finalized", "Cancelled"
  recipients      Json?
  createdAtLedger Int
  updatedAtLedger Int
  @@index([updatedAtLedger])
}

model Offer {
  offerId         BigInt   @id
  listingId       BigInt
  offerer         String
  amount          Decimal  @db.Decimal(32, 7)
  token           String
  status          String   // "Pending", "Accepted", "Rejected", "Withdrawn"
  createdAtLedger Int
  updatedAtLedger Int
  @@index([listingId])
}


model MarketplaceEvent {
  id              Int      @id @default(autoincrement())
  listingId       BigInt?
  eventType       String   // "LISTING_CREATED", "ARTWORK_SOLD", etc.
  actor           String
  data            Json
  ledgerSequence  Int
  ledgerTimestamp DateTime @default(now())
  @@index([actor])
  @@index([eventType])
  @@index([listingId])
  @@index([ledgerSequence])
  @@index([listingId, ledgerSequence])
  @@unique([listingId, eventType, ledgerSequence])
}

model Collection {
  id              Int      @id @default(autoincrement())
  contractAddress String   @unique
  kind            String   // "normal_721" | "normal_1155" | "lazy_721" | "lazy_1155"
  creator         String
  name            String?
  symbol          String?
  deployedAtLedger Int
  createdAt       DateTime @default(now())
  @@index([creator])
}

model StakedNFT {
  id              Int      @id @default(autoincrement())
  owner           String
  tokenAddress    String
  tokenId         BigInt
  collection      String
  amount          Int      @default(1)
  stakedAt        DateTime
  status          String   // "Active", "Unstaked"
  rewardsEarned   Decimal  @default(0) @db.Decimal(32, 7)
  createdAtLedger Int
  updatedAtLedger Int
  @@index([owner])
  @@index([owner, tokenAddress, tokenId])
  @@index([status])
}

model UserPreferences {
  walletAddress String   @id
  priceAlerts   Boolean  @default(false)
  theme         String   @default("dark")
  currency      String   @default("XLM")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model LendingListing {
  listingId                 BigInt   @id
  lender                    String
  nftContract               String
  tokenId                   BigInt
  declaredPriceUsd          Decimal  @db.Decimal(32, 7)
  interestScheduleBps       Int[]
  maxDurationDays           Int
  minCollateralBufferBps    Int
  liquidationThresholdBps   Int
  status                    String   // "Open", "Filled", "Cancelled"
  createdAtLedger           Int
  updatedAtLedger           Int
  @@index([lender])
  @@index([status])
  @@index([updatedAtLedger])
}

model LendingPosition {
  positionId                BigInt   @id
  listingId                 BigInt
  borrower                  String
  lender                    String
  nftContract               String
  tokenId                   BigInt
  declaredPriceUsd          Decimal  @db.Decimal(32, 7)
  collateralCurrency        String
  collateralAmount          Decimal  @db.Decimal(32, 7)
  interestScheduleBps       Int[]
  liquidationThresholdBps   Int
  startTime                 BigInt
  maxDurationSecs           BigInt
  status                    String   // "Active", "Returned", "Liquidated"
  liquidator                String?
  liquidatorBounty          Decimal? @db.Decimal(32, 7)
  lenderPayout              Decimal? @db.Decimal(32, 7)
  platformFee               Decimal? @db.Decimal(32, 7)
  borrowerRefund            Decimal? @db.Decimal(32, 7)
  healthFactor              Decimal? @db.Decimal(32, 7)
  createdAtLedger           Int
  updatedAtLedger           Int
  @@index([borrower])
  @@index([lender])
  @@index([listingId])
  @@index([status])
  @@index([healthFactor])
  @@index([updatedAtLedger])
}

model WhitelistedCurrency {
  address         String   @id
  symbol          String?
  name            String?
  decimals        Int      @default(7)
  enabled         Boolean  @default(true)
  addedAtLedger   Int
  updatedAtLedger Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([enabled])
}

model LendingConfig {
  id                    Int      @id @default(1)
  admin                 String
  feeReceiver           String
  platformFeeBps        Int
  liquidatorFeeBps      Int
  minBufferBps          Int
  maxBufferBps          Int
  minLiqThresholdBps    Int
  maxLiqThresholdBps    Int
  oracleAddress         String
  maxPriceStalenessSecs BigInt
  updatedAtLedger       Int
  updatedAt             DateTime @updatedAt
}
