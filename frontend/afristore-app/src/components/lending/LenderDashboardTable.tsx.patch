// AFTER (i18n keys):
<button onClick={handleApprove}>{t('lending.actions.approve')}</button>
<button onClick={handleReject}>{t('lending.actions.reject')}</button>
<button onClick={handleWithdraw}>{t('lending.actions.withdraw')}</button>

// BEFORE (hardcoded status labels):
const getStatusLabel = (status: string) => {
  switch (status) {
    case 'pending': return 'Pending';
    case 'active': return 'Active';
    case 'completed': return 'Completed';
    case 'defaulted': return 'Defaulted';
    default: return 'Unknown';
  }
};

// AFTER (i18n keys):
const getStatusLabel = (status: string) => {
  return t(`lending.status.${status}`, { defaultValue: t('lending.status.unknown') });
};

