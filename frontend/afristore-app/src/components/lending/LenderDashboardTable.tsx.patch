/**
 * LenderDashboardTable i18n Support (Issue #1004)
 * 
 * Replace hardcoded English strings with react-i18next translation keys.
 */

import { useTranslation } from 'react-i18next';

// ADD: Translation hook at component top
const { t } = useTranslation();

// BEFORE (hardcoded strings):
<thead>
  <tr>
    <th>Borrower</th>
    <th>Amount</th>
    <th>Interest Rate</th>
    <th>Duration</th>
    <th>Status</th>
    <th>Actions</th>
  </tr>
</thead>

// AFTER (i18n keys):
<thead>
  <tr>
    <th>{t('lending.table.borrower')}</th>
    <th>{t('lending.table.amount')}</th>
    <th>{t('lending.table.interestRate')}</th>
    <th>{t('lending.table.duration')}</th>
